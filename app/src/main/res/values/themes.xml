<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CarTrafficJam" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Plain white launch window with no icon, so it flows straight into the NG Studio intro. -->
    <style name="Theme.CarTrafficJam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.CarTrafficJam</item>
    </style>
</resources>
